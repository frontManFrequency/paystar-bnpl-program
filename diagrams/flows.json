    {
      "id": "verified_payment",
      "title": "Verified payment — one atomic economic effect",
      "kind": "sequence",
      "description": "The browser redirect is not evidence of payment. Duplicates return the same result. Only authorized creditor account and amount can be allocated.",
      "data": {
        "participants": [
          {
            "id": "C",
            "label": "Customer",
            "actor": true
          },
          {
            "id": "API",
            "label": "PayStar API"
          },
          {
            "id": "PROVIDER",
            "label": "Payment adapter"
          },
          {
            "id": "DB",
            "label": "Transactional database"
          },
          {
            "id": "UI",
            "label": "Authorized role views"
          }
        ],
        "messages": [
          {
            "from": "C",
            "to": "API",
            "text": "Request payment with idempotency key",
            "kind": "sync"
          },
          {
            "from": "API",
            "to": "PROVIDER",
            "text": "Create intent for current creditor account",
            "kind": "sync"
          },
          {
            "from": "PROVIDER",
            "to": "API",
            "text": "Signed confirmation or inquiry result",
            "kind": "async"
          },
          {
            "from": "API",
            "to": "DB",
            "text": "Lock; verify unique receipt; allocate; post balanced journal and outbox",
            "kind": "sync"
          },
          {
            "from": "DB",
            "to": "API",
            "text": "Commit one economic effect",
            "kind": "reply"
          },
          {
            "from": "API",
            "to": "UI",
            "text": "Authorized status event; refresh persisted statement",
            "kind": "async"
          },
          {
            "from": "PROVIDER",
            "to": "API",
            "text": "Duplicate callback",
            "kind": "async"
          },
          {
            "from": "API",
            "to": "PROVIDER",
            "text": "Acknowledge existing receipt; no second posting",
            "kind": "reply"
          }
        ]
      }
    }
