    {
      "id": "sale_timing",
      "title": "Model 3 — cash and legal ownership are independent",
      "kind": "flowchart",
      "description": "A cash delay never authorizes falsely displaying PayStar as current owner after legally effective transfer.",
      "data": {
        "direction": "LR",
        "nodes": [
          {
            "id": "START",
            "label": "Seller accepts exact bank offer"
          },
          {
            "id": "EVIDENCE",
            "label": "Verified legal assignment and check-holder acceptance"
          },
          {
            "id": "CASH",
            "label": "Bank purchase cash confirmed"
          },
          {
            "id": "ADVANCE",
            "label": "Cash first: bank advance held by PayStar"
          },
          {
            "id": "RECEIVABLE",
            "label": "Legal first: bank owns debt; PayStar has purchase-price receivable"
          },
          {
            "id": "SETTLED",
            "label": "Both complete: bank owns debt and seller has proceeds"
          }
        ],
        "edges": [
          {
            "from": "START",
            "to": "EVIDENCE",
            "label": "Legal evidence arrives first"
          },
          {
            "from": "START",
            "to": "CASH",
            "label": "Cash arrives first"
          },
          {
            "from": "EVIDENCE",
            "to": "RECEIVABLE",
            "label": "Effective ownership changes"
          },
          {
            "from": "CASH",
            "to": "ADVANCE",
            "label": "Do not change owner yet"
          },
          {
            "from": "RECEIVABLE",
            "to": "SETTLED",
            "label": "Purchase cash arrives"
          },
          {
            "from": "ADVANCE",
            "to": "SETTLED",
            "label": "Legal evidence becomes effective"
          }
        ]
      }
