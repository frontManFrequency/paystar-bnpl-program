{
  "name": "paystar-bnpl-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:model4": "node scripts/run-model.mjs 4 dev",
    "dev:all": "node scripts/run-model.mjs 4 dev",
    "build": "next build",
    "start:model4": "node scripts/run-model.mjs 4 start",
    "db:migrate": "tsx scripts/db.ts migrate 4",
    "db:seed": "tsx scripts/db.ts seed 4",
    "demo:reset": "tsx scripts/db.ts reset 4",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test implementation-kit/*.test.mjs && tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser": "node scripts/browser-flow.mjs",
    "screens": "node scripts/screens.mjs",
    "test:browser:mobile": "MOBILE=1 node scripts/browser-flow.mjs",
    "screens:mobile": "node scripts/screens-mobile.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "next": "15.5.29",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "puppeteer-core": "24.22.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
